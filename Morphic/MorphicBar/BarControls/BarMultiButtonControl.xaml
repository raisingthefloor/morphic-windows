<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Morphic.MorphicBar.BarControls.BarMultiButtonControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- Control palette brushes live in App.xaml (MorphicBarControl*) -->

        <!-- Non-toggle sub-button style -->
        <Style x:Key="SubButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource MorphicBarControlForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- BorderThickness=2 with BorderBrush=MorphicBarControlBorder mirrors the
                             toggle template exactly. Two reasons:
                             1. Structural height parity: the border contributes 4 logical px to the
                                outer height, matching the toggle, so both button styles size to the
                                same outer height at any DPI or rasterization scale.
                             2. Visual parity: in non-HC, MorphicBarControlBorder resolves to the same
                                green as the background, so the border is invisible (button reads as
                                solid green, like an unchecked toggle). In HC, the same brush resolves
                                to SystemColorButtonTextBrush, so the non-toggle button gets the same
                                visible HC outline that the toggle does. -->
                        <Border x:Name="BgBorder"
                                Background="{ThemeResource MorphicBarControlBackground}"
                                BackgroundSizing="OuterBorderEdge"
                                BorderBrush="{ThemeResource MorphicBarControlBorder}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <!-- CommonStates owns BgBorder.Background and ButtonText.Foreground. The
                                     "InProgress" state is entered only while ProgressStates is "Visible",
                                     so the pressed-color flip on BgBorder is part of the in-progress feedback
                                     (alongside the actual ProgressBar). ProgressBar properties are NOT set
                                     here; they live in ProgressStates below to keep the two groups from
                                     fighting over any property. -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlHoverBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlPressedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="InProgress">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlPressedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <!-- Disabled: keep the normal bg and swap the text Foreground to the
                                         system disabled-text gray, matching the Windows convention for
                                         disabled controls. -->
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlBackground}"/>
                                            <Setter Target="SubButtonText.Foreground" Value="{ThemeResource MorphicBarControlDisabledForeground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <!-- ProgressStates owns ProgressBar.Visibility/IsIndeterminate/Opacity only.
                                     "Preparing" runs the indeterminate animation invisibly (Opacity=0) so
                                     that, when "Visible" reveals the bar, its animation is already mid-cycle
                                     instead of starting fresh. See DelayedInProgressVisual.cs for the rationale. -->
                                <VisualStateGroup x:Name="ProgressStates">
                                    <VisualState x:Name="None"/>
                                    <VisualState x:Name="Preparing">
                                        <VisualState.Setters>
                                            <Setter Target="SubButtonProgressBar.Visibility" Value="Visible"/>
                                            <Setter Target="SubButtonProgressBar.IsIndeterminate" Value="True"/>
                                            <Setter Target="SubButtonProgressBar.Opacity" Value="0"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Visible">
                                        <VisualState.Setters>
                                            <Setter Target="SubButtonProgressBar.Visibility" Value="Visible"/>
                                            <Setter Target="SubButtonProgressBar.IsIndeterminate" Value="True"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid>
                                <TextBlock x:Name="SubButtonText"
                                    Text="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontFamily="Segoe UI"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    IsColorFontEnabled="False"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    Padding="10,3,10,3"/>
                                <ProgressBar x:Name="SubButtonProgressBar"
                                    Height="2"
                                    IsIndeterminate="False"
                                    Visibility="Collapsed"
                                    Foreground="{ThemeResource MorphicBarControlForeground}"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle sub-button style. Uses a single VisualStateGroup with COMPOUND state names
             (Normal/PointerOver/Pressed/Checked/CheckedPointerOver/CheckedPressed/Indeterminate/Disabled/CheckedDisabled)
             so there is no cross-group clash on the BgBorder.Background property. The code-behind's
             WireToggleButtonCompoundStates helper intercepts pointer/checked events and calls
             VisualStateManager.GoToState with the compound name. -->
        <Style x:Key="SubToggleButtonStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource MorphicBarControlForeground}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <!-- BorderThickness is fixed at 2 so the button's natural size does not change
                             when toggled on; the VSM only swaps the fill color. BorderBrush uses the
                             dedicated MorphicBarControlBorder key, which in non-HC resolves to the
                             same green as the unchecked bg (so the border is invisibly uniform when
                             unchecked, and shows as a 2px green ring when checked flips the bg to
                             white). The dedicated key is also a PLACEHOLDER for a future HC variant
                             (see the comment on MorphicBarControlBorder in App.xaml): under HC today
                             the same green resolves through, but the key exists so a contrast-text
                             binding can be added later without touching this template. -->
                        <Border x:Name="BgBorder"
                                Background="{ThemeResource MorphicBarControlBackground}"
                                BackgroundSizing="OuterBorderEdge"
                                BorderBrush="{ThemeResource MorphicBarControlBorder}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlHoverBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlPressedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlCheckedBackground}"/>
                                            <Setter Target="SubButtonText.Foreground" Value="{ThemeResource MorphicBarControlCheckedForeground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlCheckedHoverBackground}"/>
                                            <Setter Target="SubButtonText.Foreground" Value="{ThemeResource MorphicBarControlCheckedForeground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlCheckedPressedBackground}"/>
                                            <Setter Target="SubButtonText.Foreground" Value="{ThemeResource MorphicBarControlCheckedForeground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="InProgress">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlPressedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                    <!-- Disabled / CheckedDisabled: keep the toggle-state bg color (so the
                                         green-vs-white background still reads as unchecked vs checked) and
                                         swap the text Foreground to the system disabled-text gray. Matches
                                         the Windows convention for disabled toggle controls: bg shows the
                                         toggle state, gray text signals "you can't interact with this". -->
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlBackground}"/>
                                            <Setter Target="SubButtonText.Foreground" Value="{ThemeResource MorphicBarControlDisabledForeground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="BgBorder.Background" Value="{ThemeResource MorphicBarControlCheckedBackground}"/>
                                            <Setter Target="SubButtonText.Foreground" Value="{ThemeResource MorphicBarControlDisabledForeground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <!-- ProgressStates owns ProgressBar.Visibility/IsIndeterminate/Opacity only.
                                     "Preparing" runs the indeterminate animation invisibly (Opacity=0) so
                                     that, when "Visible" reveals the bar, its animation is already mid-cycle
                                     instead of starting fresh. See DelayedInProgressVisual.cs for the rationale. -->
                                <VisualStateGroup x:Name="ProgressStates">
                                    <VisualState x:Name="None"/>
                                    <VisualState x:Name="Preparing">
                                        <VisualState.Setters>
                                            <Setter Target="SubButtonProgressBar.Visibility" Value="Visible"/>
                                            <Setter Target="SubButtonProgressBar.IsIndeterminate" Value="True"/>
                                            <Setter Target="SubButtonProgressBar.Opacity" Value="0"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Visible">
                                        <VisualState.Setters>
                                            <Setter Target="SubButtonProgressBar.Visibility" Value="Visible"/>
                                            <Setter Target="SubButtonProgressBar.IsIndeterminate" Value="True"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid>
                                <TextBlock x:Name="SubButtonText"
                                    Text="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontFamily="Segoe UI"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    IsColorFontEnabled="False"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    Padding="10,3,10,3"/>
                                <ProgressBar x:Name="SubButtonProgressBar"
                                    Height="2"
                                    IsIndeterminate="False"
                                    Visibility="Collapsed"
                                    Foreground="{ThemeResource MorphicBarControlForeground}"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <TextBlock x:Name="HeaderTextBlock"
                   Foreground="{ThemeResource ThemeAwareForeground}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI"
                   FontWeight="Bold"
                   FontSize="14"
                   MaxLines="2"
                   Margin="0,3,0,3"/>
        <Grid x:Name="ButtonsContainer"/>
    </StackPanel>
</UserControl>
