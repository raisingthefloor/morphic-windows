<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Morphic.NotificationHelper</RootNamespace>
    <AssemblyName>Morphic.NotificationHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <!-- Mirrors Morphic.csproj's versioning so the helper's assembly/file version tracks
         Morphic.exe's exactly. The pipeline sets the VERSIONBUILDCOMPONENTS env var (which
         MSBuild reads as $(VersionBuildComponents)) once at the top of the build; that
         property propagates into helper here automatically because Morphic.csproj's
         ProjectReference to this project causes MSBuild to evaluate this csproj with the
         same global properties. So helper.exe ends up with the same x.y.YYDDD.RRR version
         as Morphic.exe each release. Debug builds get the -localdev suffix; Release lets
         an externally-supplied VersionSuffix pass through (effectively empty by default). -->
    <VersionPrefix>2.0$(VersionBuildComponents)</VersionPrefix>
    <VersionSuffix Condition="$(Configuration.Contains('Debug'))">localdev</VersionSuffix>
    <VersionSuffix Condition="$(Configuration.Contains('Release'))">$(VersionSuffix)</VersionSuffix>
    <Company>Raising the Floor - US, Inc.</Company>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>

    <!-- The helper is always unpackaged: it ships ALONGSIDE Morphic.exe in the MSI's install
         directory (Program Files\Morphic\), and its purpose is to be the COM activator that
         Explorer CAN successfully launch (asInvoker, no uiAccess), unlike Morphic.exe which
         is uiAccess=true and therefore can't be CreateProcess'd by Explorer for toast
         activation (error 740). MSIX builds use AppNotifications in-process and have no
         need for the helper, so the helper does not need a -Packaged configuration. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <!-- Strip the AI/ML transitive payloads exactly like Morphic.csproj does. The helper
         never calls Microsoft.Windows.AI.* APIs, so DirectML.dll / onnxruntime.dll /
         Microsoft.Windows.AI.MachineLearning.dll would be pure publish bloat. The system
         framework MSIX (installed by WindowsAppRuntimeInstall.exe) supplies them at runtime
         if anything ever indirectly needs them. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.1.10" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.1" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.1" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morphic.WindowsNative\Morphic.WindowsNative.csproj" />
  </ItemGroup>

  <!-- Publish properties: framework-dependent on the system-installed Windows App Runtime,
       same as Morphic.csproj's MSI path. The MSI installer chains WindowsAppRuntimeInstall.exe
       so the framework is present on end-user machines; the helper finds it via bootstrap
       auto-init (compiled in by WindowsAppSDK targets because OutputType=Exe and
       WindowsPackageType=None). -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun Condition="$(Configuration.Contains('Debug'))">False</PublishReadyToRun>
    <PublishReadyToRun Condition="$(Configuration.Contains('Release'))">True</PublishReadyToRun>
    <PublishTrimmed Condition="$(Configuration.Contains('Debug'))">False</PublishTrimmed>
    <PublishTrimmed Condition="$(Configuration.Contains('Release'))">False</PublishTrimmed>
  </PropertyGroup>
</Project>
