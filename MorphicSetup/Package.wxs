<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Morphic" Manufacturer="Raising the Floor - US, Inc." Version="!(bind.FileVersion.morphic_exe)" UpgradeCode="7d0ee114-79e8-4ff6-b28b-0408551483f5" InstallerVersion="500">

    <Icon Id="MorphicIcon" SourceFile="..\Morphic\Assets\Icons\morphic.ico" />
    <Property Id="ARPPRODUCTICON" Value="MorphicIcon" />

    <!-- Schedule="afterInstallInitialize" removes the previous version BEFORE installing the new
         one. The default (afterInstallExecute) installs new files first then removes the old
         product, which can race on file reference counts and leave a corrupted install; the
         WinAppSDK DLL set is large and tightly coupled, and even one stale/missing DLL crashes
         Microsoft.UI.Xaml.dll on startup with 0xc000027b. The trade-off is that a failed new
         install leaves the machine with no Morphic at all (vs. preserving the old version);
         acceptable here because the user can just re-run the installer. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="!(loc.DowngradeError)" Schedule="afterInstallInitialize" />

    <!-- Close any running Morphic.exe before install. Without this, in-use DLLs can't be
         deleted during the old product's uninstall (Windows schedules them for delete-on-reboot),
         which makes the new install think the files are still present and apply file-version
         rules to them. We send WM_ENDSESSION (EndSessionMessage, default yes) instead of WM_CLOSE
         because MorphicBarWindow intercepts WM_CLOSE -> Hide and would not actually close.
         TerminateProcess="5" force-kills if Morphic doesn't exit within 5 seconds.
         Docs: https://wixtoolset.org/docs/reference/schema/util/closeapplication/ -->
    <util:CloseApplication
        Id="CloseMorphic"
        Target="Morphic.exe"
        CloseMessage="no"
        EndSessionMessage="yes"
        RebootPrompt="no"
        TerminateProcess="5" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="MorphicComponents" />
      <ComponentRef Id="ApplicationComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <UIRef Id="WixUI_ErrorProgressText" />
	
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="BuildNumberSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Launch Condition="(WINDOWSBUILDNUMBER &gt;= 19045)" Message="!(loc.MinimumOsError)" />

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="!(bind.Property.ProductName)" />
    </StandardDirectory>
    
    <!-- ApplicationComponent: per-user component (HKCU KeyPath) that installs the Start Menu
         shortcut and the "installed=1" registry marker (the latter doubles as the KeyPath that
         ICE43 requires for any component containing a non-advertised shortcut). The shortcut's
         Target=[#morphic_exe] references a file in a DIFFERENT component (MorphicComponents,
         below); this is Microsoft's documented pattern for non-advertised shortcuts and
         intentionally triggers ICE69, which is suppressed in MorphicSetup.wixproj. Putting the
         shortcut in the same component as the file instead breaks both ICE43 (file as KeyPath
         when component has a non-advertised shortcut) and ICE57 (per-user shortcut data with
         per-machine file KeyPath). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationComponent" Guid="8BDA9AF8-9BCC-4B25-8BCF-EE06A3412358">
        <Shortcut
          Id="MorphicStartMenuShortcut"
          Name="!(bind.Property.ProductName)"
          Icon="MorphicIcon"
          Target="[#morphic_exe]"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Raising the Floor\Morphic" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MorphicComponents" Directory="INSTALLFOLDER">
      <Component>
<!--        <File Id="morphic_exe" Source="$(IntermediateOutputPath)\publish\Morphic\Morphic.exe" /> -->
        <File Id="morphic_exe" Source="Morphic.exe" />
      </Component>
      <ComponentGroupRef Id="MorphicSupportComponents" />
    </ComponentGroup>
  </Fragment>
	
</Wix>
