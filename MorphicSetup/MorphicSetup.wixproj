<Project Sdk="WixToolset.Sdk/4.0.6">
	
  <!-- Suppressed ICE checks:
       * ICE03 - incorrect-validation false positives from the WiX validation framework.
       * ICE69 - intentionally triggered by the Start Menu shortcut in ApplicationComponent
                (Package.wxs): the shortcut's Target=[#morphic_exe] references a file in a
                different component. This is Microsoft's documented best practice for
                non-advertised shortcuts (per-user shortcut in a HKCU-keyed component,
                pointing at a per-machine file in its own component); ICE69 fires anyway as
                a generic cross-component-reference warning, but in this exact pattern it's
                benign because both components are in the same Feature and install/uninstall
                atomically. See the comment on ApplicationComponent in Package.wxs for the
                rationale on why the alternative layouts trigger worse problems. -->
  <PropertyGroup>
    <RunWixToolsOutOfProc Condition=" '$(PROCESSOR_ARCHITECTURE)'!='x86' ">true</RunWixToolsOutOfProc>
    <SuppressValidation>false</SuppressValidation>
    <SuppressIces>ICE03;ICE69</SuppressIces>
  </PropertyGroup>
	
  <ItemGroup>
    <ProjectReference Include="..\Morphic\Morphic.csproj" Publish="true" />

    <HarvestDirectory Include="$(IntermediateOutputPath)\publish\Morphic">
      <ComponentGroupName>MorphicSupportComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <Transforms>heatfilter.xsl</Transforms>
    </HarvestDirectory>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="License.rtf" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="4.0.6" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
  </ItemGroup>
</Project>
