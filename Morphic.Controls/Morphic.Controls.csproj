<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
	  <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
	  <Platforms>x64;ARM64</Platforms>
	  <!-- See the Configurations comment in Morphic\Morphic.csproj for why we declare the
	       *-Packaged variants explicitly. Required for VS Configuration Manager to allow
	       mapping the solution's *-Packaged BuildTypes to a same-name project Configuration. -->
	  <Configurations>Debug;Release;Debug-Packaged;Release-Packaged</Configurations>
	  <Version>2.0.0.0</Version>
	  <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
	  <Nullable>enable</Nullable>
	  <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <!-- to enable Windows 10 support, define the INCLUDE_WINDOWS_10_SUPPORT constant below; to omit Windows 10 support just comment it out -->
  <PropertyGroup>
    <DefineConstants>INCLUDE_WINDOWS_10_SUPPORT</DefineConstants>	
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morphic.Core\Morphic.Core.csproj" />
    <ProjectReference Include="..\Morphic.WindowsNative\Morphic.WindowsNative.csproj" />
  </ItemGroup>

</Project>
