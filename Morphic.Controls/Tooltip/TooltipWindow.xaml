<?xml version="1.0" encoding="utf-8"?>
<tw:TransparentBaseWindow
    x:Class="Morphic.Controls.Tooltip.TooltipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tw="using:Morphic.Controls.Windowing">

    <Grid Background="Transparent">
        <!-- Background and BorderBrush are assigned from code-behind so we can match the Win11
             tooltip palette per theme (light / dark / HC light / HC dark) without depending on
             a system brush that does not resolve cleanly in WinUI 3 for non-control backgrounds.
             SystemColorWindowTextBrush works for the text fill in all four modes, so we leave
             TooltipTextBlock.Foreground bound to that ThemeResource.
             BackgroundSizing=OuterBorderEdge extends the fill under the border ring, eliminating
             the corner-seam aliasing that otherwise shows where Background (drawn inside the
             border) meets BorderBrush along the rounded corner.
             TooltipTextBlock has Horizontal/VerticalAlignment=Center so it sizes to its text
             content (instead of stretching to MaxWidth) and is properly centered vertically. -->
        <Border x:Name="RootBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BackgroundSizing="OuterBorderEdge"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,6,8,7">
            <TextBlock x:Name="TooltipTextBlock"
                       Foreground="{ThemeResource SystemColorWindowTextBrush}"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320"/>
        </Border>
    </Grid>
</tw:TransparentBaseWindow>
