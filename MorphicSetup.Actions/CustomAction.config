<?xml version="1.0" encoding="utf-8"?>
<!-- Tells WiX DTF's SfxCA bootstrap which .NET runtime to activate before loading the
     managed custom-action assembly. Without this file, SfxCA defaults to CLR v2.0.50727
     (the .NET 2.0/3.5 runtime), which then refuses our .NET Framework 4.7.2 assembly
     with System.BadImageFormatException ("assembly is built by a runtime newer than the
     currently loaded runtime"). The runtime is selected at SfxCA startup, so this file
     MUST ship alongside (actually: inside) the .CA.dll; DTF's MakeSfxCA tool embeds
     <Content>-marked files automatically when packing the SFX archive.

     useLegacyV2RuntimeActivationPolicy="true" is the canonical setting for DTF-wrapped
     CAs: it tells the CLR 4 host to honor the v2-style activation policy that SfxCA
     uses to spin up the AppDomain. -->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0.30319" />
  </startup>
</configuration>
